@model List<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "All Movies";
}

<h1>
    All Movies
</h1>

<p>
    @Model.Count movies.
</p>

@foreach(var movie in Model)
{
    <h5>
        @movie.Title (@movie.ReleaseDate)
        
    </h5>
    <p><a asp-action="Details" asp-route-id="@movie.Id">Details</a></p>
}

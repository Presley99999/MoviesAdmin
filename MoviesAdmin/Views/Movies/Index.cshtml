@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<h1>Add Movies</h1>

<p>
    <a asp-action="Create">Add a Movie</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Poster</th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Synopsis)
            </th>
            <th>Genre</th>
            <th>Audience Rating</th>
            <th>
                @Html.DisplayNameFor(model => model.Runtime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
@foreach (var item in Model)
{
        <tr>

            <td>
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl"
                         style="width:80px;height:120px;object-fit:cover;border:1px solid #ccc;border-radius:4px;" />
                }
                else
                {
                    <span>No Image</span>
                }
            </td>

            <td>
                @Html.DisplayFor(model => item.Title)
            </td>

            <td>
                @(item.Synopsis?.Length > 100
                    ? item.Synopsis.Substring(0, 100) + "..."
                    : item.Synopsis)
            </td>

            <td>
                @item.Genre.Title
            </td>

            <td>
                @item.AudienceRating.Title
            </td>

            <td>
                @Html.DisplayFor(model => item.Runtime) mins
            </td>

            <td>
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>

                    @if (User.IsInRole("administrator"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    }
                </td>
        </tr>
}
    </tbody>
</table>
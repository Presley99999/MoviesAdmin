@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Add Movies";
}

<h1>Add Movies</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Poster</th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Synopsis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Runtime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <th>
                @Html.DisplayFor(model => item.Title)
            </th>
            <th>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             style="width:80px;height:120px;object-fit:cover;border:1px solid #ccc;border-radius:4px;" />
                    }
                    else
                    {
                        <span>No Image</span>
                    }
            </th>
                    
            <th>
                    @(item.Synopsis?.Length > 100
                        ? item.Synopsis.Substring(0, 100) + "..."
                        : item.Synopsis)

            </th>
               
               

            <th>
                @Html.DisplayFor(model => item.Genre)
            </th>
            <th>
                @Html.DisplayFor(model => item.Rating)
            </th>
            <th>
                @Html.DisplayFor(model => item.Runtime) mins 
            </th>
            <th>
                @Html.DisplayFor(model => item.ReleaseDate)
            </th>
            <th>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>

                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> 
               
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </th>
        </tr>
}
    </tbody>
</table>

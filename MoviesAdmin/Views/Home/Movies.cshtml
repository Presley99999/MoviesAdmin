@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Movie Details: " + Model.Title;
}

<h1>
    @Model.Title
</h1>

<p>
    @Model.ReleaseDate
    @Model.Synopsis
</p>

<p>
    
    Audience rating: @Model.AudienceRating?.Title<br />
    Runtime: @Model.Runtime mins<br />
    Genre: @Model.Genre
</p>